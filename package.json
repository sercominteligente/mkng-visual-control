  "dependencies": {
    "hono": "^4.9.8",
    "pdf-lib": "^1.17.1",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "typescript": "^5.9.2",
    "vite": "8.0.13",
    "wrangler": "4.118.0"
  }
}
